generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServiceState {
  REJECTED
  ACCEPTED
  CANCELED
  COMPLETED
  PENDING
}

model User {
  id                Int              @id @default(autoincrement())
  email             String           @unique
  name              String
  lastName          String
  password          String
  phone             String
  workRadius        Decimal?
  picture           String
  rating            Decimal?
  description       String
  hasPendingReviews Boolean          @default(false)
  UserProfession    UserProfession[]
  usedServices      Service[]        @relation("userId")
  providedServices  Service[]        @relation("providerId")
  userAddresses     UserAddress[]
}

model Address {
  id            Int           @id @default(autoincrement())
  street        String
  number        Int
  postalCode    Int
  country       String
  province      String
  floor         String
  services      Service[]
  userAddresses UserAddress[]
}

model Profession {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  picture        String
  UserProfession UserProfession[]
  Service        Service[]
}

model UserProfession {
  userId       Int
  user         User       @relation(fields: [userId], references: [id])
  professionId Int
  profession   Profession @relation(fields: [professionId], references: [id])

  @@unique([userId, professionId])
}

model UserAddress {
  userId    Int
  user      User    @relation(fields: [userId], references: [id])
  addressId Int
  address   Address @relation(fields: [addressId], references: [id])

  @@unique([userId, addressId])
}

model Service {
  id           Int          @id @default(autoincrement())
  professionId Int
  profession   Profession   @relation(fields: [professionId], references: [id])
  userId       Int
  user         User         @relation("userId", fields: [userId], references: [id])
  providerId   Int
  provider     User         @relation("providerId", fields: [providerId], references: [id])
  rating       Decimal?
  price        Decimal?
  comment      String?
  date         DateTime
  isReviewed   Boolean      @default(false)
  addressId    Int          @default(1)
  address      Address      @relation(fields: [addressId], references: [id])
  state        ServiceState @default(PENDING)
}
